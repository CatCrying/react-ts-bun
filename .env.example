# Any long random string — used to sign login JWTs.
# Generate one with: openssl rand -base64 48
JWT_SECRET=

# Which database backend to use: mongodb | sqlite | postgres | mysql
# Defaults to mongodb if unset.
DB_MODE=mongodb

# --- mongodb (DB_MODE=mongodb) ---
# mongodb+srv://user:pass@cluster.mongodb.net/pastebin?retryWrites=true&w=majority
MONGODB_URI=

# --- sqlite (DB_MODE=sqlite) — local development only, see README ---
# Path to the local .db file. Defaults to ./pastebin.db if unset.
SQLITE_PATH=./pastebin.db

# --- postgres (DB_MODE=postgres) ---
# postgres://user:pass@host:5432/pastebin
POSTGRES_URL=

# --- mysql (DB_MODE=mysql) ---
# mysql://user:pass@host:3306/pastebin
MYSQL_URL=
